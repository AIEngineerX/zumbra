{
  "mcpServers": {
    "zumbra": {
      "command": "zumbra-mcp",
      "env": {
        "OWS_WALLET": "default",
        "OWS_PASSPHRASE": "",
        "ZUMBRA_DATA_DIR": "/path/to/.zumbra/mainnet",
        "FIRECRAWL_API_KEY": "fc-..."
      }
    },
    "cipherpay": {
      "command": "npx",
      "args": ["-y", "@cipherpay/mcp"],
      "env": {
        "CIPHERPAY_API_KEY": "your-cipherpay-api-key"
      }
    }
  }
}
