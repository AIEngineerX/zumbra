FROM rust:1.82-slim-bookworm AS builder

RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    cmake \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY rust/ ./

RUN cargo build --release -p zumbra -p zumbra-mcp

# --- Runtime ---
FROM debian:bookworm-slim AS base

RUN apt-get update && apt-get install -y \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/target/release/zumbra /usr/local/bin/
COPY --from=builder /build/target/release/zumbra-mcp /usr/local/bin/

RUN mkdir -p /root/.zumbra/mainnet /root/.zumbra/testnet

# --- CLI image ---
FROM base AS cli

ENV ZUMBRA_DATA_DIR=/root/.zumbra/mainnet
ENTRYPOINT ["zumbra"]

# --- MCP server image ---
FROM base AS mcp-server

ENV ZUMBRA_DATA_DIR=/root/.zumbra/mainnet
EXPOSE 3000
ENTRYPOINT ["zumbra-mcp"]
