# ── Secrets — never commit. The pre-commit hook in .githooks also blocks these. ──
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
key.properties
*keypair*.json
id_*.json
*.mnemonic
*.seed
seed.txt
policy.toml
!policy.example.toml

# ── Wallet runtime state (data dirs, databases, audit logs) ──
data/
.zumbra/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db
*.db-shm
*.db-wal
audit.sqlite
sessions.json
sessions.enc
pending_proposal.json
logs/
*.log

# ── Rust ──
target/
**/*.rs.bk
*.pdb
.cargo/
# Cargo.lock is committed on purpose: this workspace ships binaries.

# ── Node / npm launcher ──
node_modules/
/npm/native/
/npm/bin/*.exe
npm-debug.log*

# ── Build output ──
/build/
build-dir/
dist/
# Brand exports are generated but committed: README and the site link to them.
!brand/dist/
# Owner-private planning: the plan, the fork-time audit, the project map, captured references,
# and the X kit. Never in the public tree. Generators for the kit live in brand/tools.
.private/
*.a
*.so
*.dylib
*.dll
jniLibs/

# ── Test + tooling output ──
coverage/
test-results/
playwright-report/
.playwright-mcp/
.firecrawl/
.pytest_cache/

# ── Editors / OS / agents ──
.DS_Store
Thumbs.db
.idea/
*.iml
.vscode/
!.vscode/extensions.json
.cursor/
.agents/
.refs/
.history
*.swp
